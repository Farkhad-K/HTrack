@page "{id:guid}"
@model HTrack.Api.Pages.Admin.Companies.EditModel
@{
    ViewData["Title"] = "Kompaniyani tahrirlash";
}

<h4 class="mb-3">Kompaniyani tahrirlash</h4>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" style="max-width:500px">
    <input type="hidden" name="id" value="@Model.CompanyId" />
    <div class="mb-3">
        <label for="name" class="form-label">Nomi</label>
        <input type="text" id="name" name="name" class="form-control" value="@Model.Name" required />
    </div>
    <div class="mb-3">
        <label for="tgChatId" class="form-label">Telegram Chat ID</label>
        <input type="number" id="tgChatId" name="tgChatId" class="form-control" value="@Model.TgChatID" required />
    </div>
    <div class="mb-3">
        <label for="managerIds" class="form-label">Menejer Telegram ID lari (vergul bilan ajrating)</label>
        <textarea id="managerIds" name="managerIds" class="form-control" rows="3">@Model.ManagerIdsText</textarea>
    </div>
    <a asp-page="Index" class="btn btn-secondary">Bekor qilish</a>
    <button type="submit" class="btn btn-primary">Saqlash</button>
</form>
