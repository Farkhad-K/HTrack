@page
@model HTrack.Api.Pages.Admin.Companies.IndexModel
@{
    ViewData["Title"] = "Kompaniyalar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Kompaniyalar</h4>
    <a asp-page="Create" class="btn btn-primary btn-sm">+ Qo'shish</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nomi</th>
            <th>Telegram Chat ID</th>
            <th>Menejerlar soni</th>
            <th>Amallar</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.Companies)
        {
            <tr>
                <td>@c.Name</td>
                <td>@c.TgChatID</td>
                <td>@c.ManagerTgUserIDs.Count</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Tahrirlash</a>
                    <form method="post" asp-page-handler="Delete" class="d-inline"
                          onsubmit="return confirm('O\'chirish uchun tasdiqlang')">
                        <input type="hidden" name="id" value="@c.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">O'chirish</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Companies.Any())
        {
            <tr><td colspan="4" class="text-center text-muted">Ma'lumot yo'q</td></tr>
        }
    </tbody>
</table>
