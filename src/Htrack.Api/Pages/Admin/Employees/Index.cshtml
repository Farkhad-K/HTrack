@page
@model HTrack.Api.Pages.Admin.Employees.IndexModel
@{
    ViewData["Title"] = "Xodimlar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Xodimlar</h4>
    <a asp-page="Create" asp-route-companyId="@Model.SelectedCompanyId" class="btn btn-primary btn-sm">+ Qo'shish</a>
</div>

<form method="get" class="mb-3 d-flex gap-2 align-items-center" style="max-width:400px">
    <select name="companyId" class="form-select" onchange="this.form.submit()">
        <option value="">— Kompaniya tanlang —</option>
        @foreach (var c in Model.Companies)
        {
            <option value="@c.Id" selected="@(c.Id == Model.SelectedCompanyId)">@c.Name</option>
        }
    </select>
</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.SelectedCompanyId != Guid.Empty)
{
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Ismi</th>
                <th>RFID UID</th>
                <th>Amallar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Employees)
            {
                <tr>
                    <td>@e.Name</td>
                    <td><code>@e.RFIDCardUID</code></td>
                    <td>
                        <a asp-page="Edit"
                           asp-route-companyId="@Model.SelectedCompanyId"
                           asp-route-rfid="@e.RFIDCardUID"
                           class="btn btn-sm btn-outline-secondary">Tahrirlash</a>
                        <form method="post" asp-page-handler="Delete" class="d-inline"
                              onsubmit="return confirm('O\'chirish uchun tasdiqlang')">
                            <input type="hidden" name="id" value="@e.Id" />
                            <input type="hidden" name="companyId" value="@Model.SelectedCompanyId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">O'chirish</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Employees.Any())
            {
                <tr><td colspan="3" class="text-center text-muted">Xodimlar yo'q</td></tr>
            }
        </tbody>
    </table>
}
