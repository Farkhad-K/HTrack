<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — HTrack Admin" : "HTrack Admin")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { min-height: 100vh; }
        .sidebar { min-height: 100vh; background: #212529; }
        .sidebar .nav-link { color: #adb5bd; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color: #fff; background: rgba(255,255,255,.1); border-radius: 4px; }
    </style>
</head>
<body>
<div class="container-fluid">
    <div class="row">
        @{
            var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        }
        <nav class="col-md-2 sidebar py-3 px-2 d-flex flex-column">
            <div class="text-white fw-bold fs-5 mb-4 px-2">HTrack Admin</div>
            <ul class="nav flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link px-2 @(currentPage.StartsWith("/Admin/Companies") ? "active" : "")"
                       asp-page="/Admin/Companies/Index">Kompaniyalar</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2 @(currentPage.StartsWith("/Admin/Employees") ? "active" : "")"
                       asp-page="/Admin/Employees/Index">Xodimlar</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2 @(currentPage.StartsWith("/Admin/Attendances") ? "active" : "")"
                       asp-page="/Admin/Attendances/Index">Davomat</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2 @(currentPage.StartsWith("/Admin/Reports") ? "active" : "")"
                       asp-page="/Admin/Reports/Index">Hisobotlar</a>
                </li>
            </ul>
            <div class="mt-auto pt-4 px-2">
                <form method="post" asp-page="/Login" asp-page-handler="Logout">
                    <button type="submit" class="btn btn-sm btn-outline-secondary text-white">Chiqish</button>
                </form>
            </div>
        </nav>
        <main class="col-md-10 py-4 px-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
